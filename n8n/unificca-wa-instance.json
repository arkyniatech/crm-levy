            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (function(){\n  const r = $('uazapi status').first().json || {};\n  const i = r.instance || {};\n  const s = String(r.status || i.status || '');\n  const validos = ['disconnected','connecting','connected','hibernated','registering','registration_conflict'];\n  const st = validos.indexOf(s) >= 0 ? s : 'disconnected';\n  const out = { status: st, last_status_at: new Date().toISOString(), updated_at: new Date().toISOString() };\n  // a constraint da tabela recusa valor fora da lista: guarda o original\n  if (validos.indexOf(s) < 0 && s) out.last_error = 'status desconhecido da uazapi: ' + s;\n  const fone = r.phone || i.phone || i.owner || null;\n  if (fone) out.phone = String(fone).split('@')[0].replace(/[^0-9]/g, '');\n  const nome = r.profileName || i.profileName || i.profile_name || null;\n  if (nome) out.profile_name = nome;\n  return JSON.stringify(out);\n})() }}"
      },
